<section class="tab inventory-tab {{tabs.inventory.cssClass}}" data-tab="inventory" data-group="primary">
  <section class="inventory-header">
    <label>{{localize "GLOOM.Mercenary.gold"}} <input type="number" name="system.gold" value="{{system.gold}}" min="0" step="1"></label>
    {{#if editable}}
    <a class="item-control" data-action="importItems" data-tab="inventory" data-tooltip="GLOOM.Import.title"><i class="fa-solid fa-file-import"></i></a>
    {{/if}}
  </section>
  {{#each slots as |sl|}}
  <section class="slot slot-{{sl.slot}}">
    <h3>
      {{sl.label}}
      {{#if sl.capacity}}<span class="hint{{#if sl.over}} over{{/if}}">{{sl.equipped}}/{{sl.capacity}}</span>{{/if}}
      {{#if @root.editable}}<a class="item-control" data-action="createItem" data-type="equipment" data-slot="{{sl.slot}}" data-tooltip="GLOOM.Item.create"><i class="fa-solid fa-plus"></i></a>{{/if}}
    </h3>
    <ul class="item-list">
      {{#each sl.items as |e|}}
      <li class="item equipment state-{{e.state}}{{#if e.equipped}} equipped{{/if}}" data-item-id="{{e.id}}">
        {{#unless (eq sl.slot "none")}}<a class="prep" {{#if @root.editable}}data-action="toggleEquipped"{{/if}} data-tooltip="GLOOM.Equipment.equipped"><i class="fa-{{#if e.equipped}}solid{{else}}regular{{/if}} fa-circle-check"></i></a>{{/unless}}
        <img src="{{e.img}}" alt="">
        <a class="item-name" data-action="toggleDetails" data-tooltip="GLOOM.Act.details"><i class="fa-solid fa-caret-{{#if e.expanded}}down{{else}}right{{/if}} caret"></i> {{e.name}}</a>
        {{#if e.plannable}}<span class="plan-picks"><a class="plan-pick{{#if e.isPrimary}} on{{/if}}" data-action="planPick" data-slot="primary" data-tooltip="GLOOM.Power.primary">P</a>{{#if e.canSecondary}}<a class="plan-pick{{#if e.isSecondary}} on{{/if}}" data-action="planPick" data-slot="secondary" data-tooltip="GLOOM.Power.secondary">S</a>{{/if}}</span>{{/if}}
        <a class="item-control post" data-action="postItem" data-tooltip="GLOOM.Item.post"><i class="fa-solid fa-comment"></i></a>
        {{#if e.consumable}}<span class="tag">×{{e.quantity}}</span>{{/if}}
        {{#if e.uses}}<span class="tag" data-tooltip="GLOOM.Equipment.usesLeft">{{e.uses}}</span>{{/if}}
        {{#if e.initiative}}<span class="tag init" data-tooltip="GLOOM.Item.initiative">{{e.initiative}}</span>{{/if}}
        <span class="state">{{localize (concat "GLOOM.Power.state." e.state)}}</span>
        {{#if @root.editable}}
        {{#if e.ready}}<a class="item-control" data-action="useItem" data-tooltip="GLOOM.Power.use"><i class="fa-solid fa-hand"></i></a>
        {{else}}<a class="item-control" data-action="readyItem" data-tooltip="GLOOM.Power.recover"><i class="fa-solid fa-rotate-left"></i></a>{{/if}}
        <a class="item-control" data-action="editItem" data-tooltip="GLOOM.Item.edit"><i class="fa-solid fa-pen"></i></a>
        <a class="item-control" data-action="deleteItem" data-tooltip="GLOOM.Item.delete"><i class="fa-solid fa-trash"></i></a>
        {{/if}}
        {{#if e.expanded}}{{> "gloom.power-details" e.details}}{{/if}}
      </li>
      {{else}}<li class="empty">—</li>{{/each}}
    </ul>
  </section>
  {{/each}}
</section>
