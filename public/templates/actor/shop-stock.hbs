<section class="tab stock-tab {{tabs.stock.cssClass}}" data-tab="stock" data-group="primary">
  {{#if isGM}}
  <div class="shop-tools">
    <button type="button" data-action="restock"><i class="fa-solid fa-dice"></i> {{localize "GLOOM.Shop.restock"}}</button>
    <span class="hint">{{localize "GLOOM.Shop.dropHint"}}</span>
  </div>
  {{/if}}
  <ul class="item-list shop-items">
    {{#each stock as |i|}}
    <li class="item shop-item{{#unless i.allowed}} blocked{{/unless}}{{#if i.soldOut}} sold-out{{/if}}" data-item-id="{{i.id}}">
      <img src="{{i.img}}" alt="">
      <div class="item-name">
        <a data-action="toggleDetails">{{i.name}}</a>
        <span class="tag rarity rarity-{{i.rarity}}">{{i.rarityLabel}}</span>
        {{#if i.slotLabel}}<span class="tag">{{i.slotLabel}}</span>{{/if}}
        {{#if i.consumable}}<span class="tag">{{localize "GLOOM.Equipment.consumable"}}</span>{{/if}}
        {{#if i.markup}}<span class="tag" data-tooltip="GLOOM.Shop.rarityMarkupHint">+{{i.markup}} g</span>{{/if}}
        {{#if i.expanded}}<div class="desc">{{{i.effect}}}</div>{{/if}}
      </div>
      <span class="stock-count" data-tooltip="GLOOM.Shop.stock">
        {{#if @root.isGM}}<input type="number" class="stock-qty" value="{{i.quantity}}" min="0" step="1" data-stock>{{else}}×{{i.quantity}}{{/if}}
      </span>
      <span class="price{{#if i.discounted}} discounted{{/if}}" data-tooltip="{{#if i.discounted}}{{i.basePrice}} g{{/if}}">{{i.price}} g</span>
      <button type="button" class="buy" data-action="buy" data-player-control {{#unless i.canClick}}disabled data-blocked{{/unless}} data-tooltip="{{i.reason}}">
        <i class="fa-solid fa-cart-shopping"></i> {{localize "GLOOM.Shop.buy"}}</button>
      {{#if @root.isGM}}
      <a class="item-control" data-action="editItem" data-tooltip="GLOOM.Item.edit"><i class="fa-solid fa-pen"></i></a>
      <a class="item-control" data-action="deleteItem" data-tooltip="GLOOM.Item.delete"><i class="fa-solid fa-trash"></i></a>
      {{/if}}
    </li>
    {{else}}<li class="empty">{{localize "GLOOM.Shop.empty"}}</li>{{/each}}
  </ul>
</section>
