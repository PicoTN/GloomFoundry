<section class="tab overview-tab {{tabs.overview.cssClass}}" data-tab="overview" data-group="primary">
  <section class="npc-stats">
    <div class="big-stats">
      <div class="stat"><span class="label">{{localize "GLOOM.Npc.move"}}</span><span class="value">{{system.current.move}}</span></div>
      <div class="stat"><span class="label">{{localize "GLOOM.Npc.attack"}}</span><span class="value">{{system.current.attack}}</span></div>
      {{#if system.current.defense}}<div class="stat"><span class="label">DFNS</span><span class="value marker">{{system.current.defense}}</span></div>{{/if}}
      {{#if system.current.offense}}<div class="stat"><span class="label">OFNS</span><span class="value marker">{{system.current.offense}}</span></div>{{/if}}
      <div class="stat"><span class="label">{{localize "GLOOM.Npc.initiative"}}</span><span class="value small">F {{system.initiative.fast}} · N {{system.initiative.normal}} · S {{system.initiative.slow}}</span></div>
      <div class="stat"><span class="label">{{localize "GLOOM.Npc.tactics"}}</span><span class="value small">{{system.tactics}}/5</span></div>
    </div>
    {{#if system.markers.defense}}<p class="hint"><strong>DFNS</strong> {{system.markers.defense}}</p>{{/if}}
    {{#if system.markers.offense}}<p class="hint"><strong>OFNS</strong> {{system.markers.offense}}</p>{{/if}}
  </section>

  <section class="attributes">
    <h3>{{localize "GLOOM.Mercenary.attributes"}}</h3>
    <div class="attribute-grid">
      {{#each attributes}}
      <div class="attribute">
        <button type="button" class="test" data-action="testAttribute" data-attribute="{{key}}" data-tooltip="GLOOM.Test.clickToTest">
          <span class="abbr">{{abbr}}</span><span class="label">{{label}}</span>
        </button>
        <span class="score">{{value}}</span>
      </div>
      {{/each}}
    </div>
  </section>

  <section class="gloom-deck-panel">
    <div class="deck-buttons">
      <button type="button" data-action="testAttribute"><i class="fa-solid fa-dice-d6"></i> {{localize "GLOOM.Test.title"}}</button>
      <button type="button" data-action="drawAttack"><i class="fa-solid fa-swords"></i> {{localize "GLOOM.Attack.title"}} ({{system.current.attack}})</button>
    </div>
    <p class="hint"><i class="fa-solid fa-layer-group"></i> {{deckLabel}}
      {{#if controllerName}} · {{localize "GLOOM.Npc.summonOf"}} <strong>{{controllerName}}</strong>
      {{#if editable}}<a data-action="clearController" data-tooltip="GLOOM.Npc.clearController"><i class="fa-solid fa-xmark"></i></a>{{/if}}
      {{else}} · <span class="hint">{{localize "GLOOM.Npc.summonHint"}}</span>{{/if}}
    </p>
  </section>

  <section class="actions">
    <h3>
      {{localize "GLOOM.NpcAction.plural"}}
      {{#if editable}}<a class="item-control" data-action="createAction" data-tooltip="GLOOM.Item.create"><i class="fa-solid fa-plus"></i></a>{{/if}}
    </h3>
    <ul class="item-list">
      {{#each actions as |a|}}
      <li class="item npc-action{{#unless a.available}} unavailable{{/unless}}{{#if a.elite}} elite{{/if}}" data-item-id="{{a.id}}">
        <span class="tag speeds">{{a.speeds}}</span>
        <a class="item-name" data-action="postItem" data-tooltip="GLOOM.Item.post">{{a.name}}</a>
        {{#if a.kindLabel}}<span class="tag">{{a.kindLabel}}</span>{{/if}}
        {{#if a.elite}}<span class="tag elite-tag">{{localize "GLOOM.Npc.category.elite"}}</span>{{/if}}
        {{#if a.nemesis}}<span class="tag nemesis-tag">{{localize "GLOOM.Npc.category.nemesis"}}</span>{{/if}}
        {{#if @root.editable}}
        <a class="item-control" data-action="editItem" data-tooltip="GLOOM.Item.edit"><i class="fa-solid fa-pen"></i></a>
        <a class="item-control" data-action="deleteItem" data-tooltip="GLOOM.Item.delete"><i class="fa-solid fa-trash"></i></a>
        {{/if}}
      </li>
      {{else}}<li class="empty">{{localize "GLOOM.NpcAction.none"}}</li>{{/each}}
    </ul>
    <p class="hint">{{localize "GLOOM.NpcAction.basicHint"}}</p>
  </section>

  <section class="conditions">
    <h3>{{localize "GLOOM.Condition.plural"}}</h3>
    <div class="condition-grid">
      {{#each conditions as |c|}}
      <div class="condition {{c.kind}}{{#if c.active}} active{{/if}}" data-condition="{{c.id}}">
        <button type="button" data-action="toggleCondition"{{#unless ../editable}} disabled{{/unless}}><img src="{{c.img}}" alt=""> <span>{{c.label}}</span></button>
      </div>
      {{/each}}
    </div>
  </section>
</section>
