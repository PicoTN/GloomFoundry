<section class="sheet-body">
  <section class="attributes">
    <h3>{{localize "GLOOM.Mercenary.attributes"}}</h3>
    <div class="attribute-grid">
      {{#each attributes}}
      <div class="attribute">
        <button type="button" class="test" data-action="testAttribute" data-attribute="{{key}}" data-tooltip="GLOOM.Test.clickToTest">
          <span class="abbr">{{abbr}}</span>
          <span class="label">{{label}}</span>
        </button>
        <input type="number" name="system.attributes.{{key}}" value="{{value}}" min="0" max="7" step="1">
      </div>
      {{/each}}
    </div>
  </section>

  <section class="gloom-deck-panel">
    <h3>{{localize "GLOOM.Deck.title"}}</h3>
    {{#if deck}}
    {{> "gloom.deck-counts" deck}}
    <div class="deck-buttons">
      <button type="button" data-action="testAttribute"{{#unless deck.canDraw}} disabled{{/unless}}><i class="fa-solid fa-dice-d6"></i> {{localize "GLOOM.Test.title"}}</button>
      <button type="button" data-action="drawAttack"{{#unless deck.canDraw}} disabled{{/unless}}><i class="fa-solid fa-swords"></i> {{localize "GLOOM.Attack.title"}}</button>
    </div>
    <div class="deck-buttons small">
      <button type="button" data-action="addBless">+ {{localize "GLOOM.Card.bless"}}</button>
      <button type="button" data-action="addCurse">+ {{localize "GLOOM.Card.curse"}}</button>
      {{#if editable}}
      <button type="button" data-action="clearTemporary">{{localize "GLOOM.Deck.clearTemporary"}}</button>
      <button type="button" data-action="reshuffle"><i class="fa-solid fa-shuffle"></i> {{localize "GLOOM.Deck.reshuffle"}}</button>
      <button type="button" data-action="openDeck" data-pile="draw"><i class="fa-solid fa-folder-open"></i> {{localize "GLOOM.Deck.open"}}</button>
      <button type="button" data-action="rebuildDeck"><i class="fa-solid fa-rotate"></i> {{localize "GLOOM.Deck.rebuild"}}</button>
      {{/if}}
    </div>
    {{#if deck.recent.length}}
    <h4>{{localize "GLOOM.Deck.recent"}}</h4>
    <div class="cards">{{#each deck.recent}}{{> "gloom.modifier-card" this}}{{/each}}</div>
    {{/if}}
    {{else}}
    <p class="notes">{{localize "GLOOM.Deck.notReady"}}</p>
    <button type="button" data-action="createDeck">{{localize "GLOOM.Deck.create"}}</button>
    {{/if}}
  </section>

  {{#if editable}}
  <section class="rests">
    <h3>{{localize "GLOOM.Rest.title"}}</h3>
    <div class="deck-buttons small">
      <button type="button" data-action="quickBreath" data-tooltip="GLOOM.Rest.quickBreathHint"><i class="fa-solid fa-wind"></i> {{localize "GLOOM.Rest.quickBreath"}}</button>
      <button type="button" data-action="fullRest" data-tooltip="GLOOM.Rest.fullRestHint"><i class="fa-solid fa-bed"></i> {{localize "GLOOM.Rest.fullRest"}}</button>
    </div>
  </section>
  {{/if}}

  <section class="backgrounds">
    <h3>
      {{localize "GLOOM.Background.plural"}}
      {{#if editable}}<a class="item-control" data-action="createBackground" data-tooltip="GLOOM.Background.create"><i class="fa-solid fa-plus"></i></a>{{/if}}
    </h3>
    <ul class="item-list">
      {{#each backgrounds}}
      <li class="item{{#if expended}} expended{{/if}}" data-item-id="{{id}}">
        <img src="{{img}}" alt="">
        <span class="item-name">{{name}}</span>
        {{#if ../editable}}
        <a class="item-control" data-action="toggleExpended" data-tooltip="GLOOM.Background.toggleExpended"><i class="fa-solid {{#if expended}}fa-hourglass-end{{else}}fa-check{{/if}}"></i></a>
        <a class="item-control" data-action="editItem" data-tooltip="GLOOM.Item.edit"><i class="fa-solid fa-pen"></i></a>
        <a class="item-control" data-action="deleteItem" data-tooltip="GLOOM.Item.delete"><i class="fa-solid fa-trash"></i></a>
        {{/if}}
      </li>
      {{else}}
      <li class="empty">{{localize "GLOOM.Background.none"}}</li>
      {{/each}}
    </ul>
  </section>

  <section class="biography">
    <h3>{{localize "GLOOM.Mercenary.personalGoal"}}</h3>
    <input type="text" name="system.personalGoal" value="{{system.personalGoal}}">
    <h3>{{localize "GLOOM.Mercenary.biography"}}</h3>
    {{formInput systemFields.biography value=system.biography enriched=enrichedBiography toggled=true name="system.biography"}}
  </section>
</section>
