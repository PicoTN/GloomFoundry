<header class="sheet-header">
  <img class="profile" src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" data-edit="img">
  <div class="identity">
    <input class="name" type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'Name'}}">
    {{#if isBlank}}<button type="button" class="gloom-open-creation" data-action="openCreation"><i class="fa-solid fa-user-plus"></i> {{localize "GLOOM.Creation.openWizard"}}</button>{{/if}}
    <div class="row">
      <label>{{localize "GLOOM.Mercenary.pronouns"}}<input type="text" name="system.pronouns" value="{{system.pronouns}}"></label>
      <label>{{localize "GLOOM.Mercenary.ancestry"}}<input type="text" name="system.ancestry" value="{{system.ancestry}}"{{#if ancestryItem}} disabled{{/if}}></label>
      <label>{{localize "GLOOM.Mercenary.className"}}<input type="text" name="system.className" value="{{system.className}}"{{#if classItem}} disabled{{/if}}></label>
    </div>
    <div class="row stats">
      <label>{{localize "GLOOM.Mercenary.level"}}<input type="number" name="system.level" value="{{system.level}}" min="1" max="9" step="1"></label>
      {{#if canLevelUp}}<button type="button" class="gloom-level-up-button" data-action="levelUp"><i class="fa-solid fa-angles-up"></i> {{localize "GLOOM.LevelUp.button"}}</button>{{/if}}
      <label class="hp">{{localize "GLOOM.Mercenary.hp"}}
        <span class="pair">
          <input type="number" name="system.hp.value" value="{{system.hp.value}}" min="0" step="1">
          <span class="sep">/</span>
          <input type="number" name="system.hp.max" value="{{system.hp.max}}" min="0" step="1"{{#if system.hpFromClass}} disabled data-tooltip="GLOOM.Mercenary.hpFromClass"{{/if}}>
        </span>
      </label>
    </div>
  </div>
</header>
