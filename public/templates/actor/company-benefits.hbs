<section class="tab benefits-tab {{tabs.benefits.cssClass}}" data-tab="benefits" data-group="primary">
  {{#if wardPending}}<p class="notice"><i class="fa-solid fa-shield"></i> {{localize "GLOOM.Company.wardPending"}}</p>{{/if}}
  <h3>{{localize "GLOOM.Company.permanent"}}</h3>
  <ul class="item-list benefits">
    {{#each permanent as |b|}}
    <li class="item benefit" data-item-id="{{b.id}}">
      <div class="item-name"><strong>{{b.name}}</strong>{{#if b.level}} <span class="tag">{{localize "GLOOM.Company.level"}} {{b.level}}</span>{{/if}}
        <div class="desc">{{{b.description}}}</div></div>
      {{#if b.automation}}<a class="item-control" data-action="useBenefit" data-tooltip="GLOOM.Company.use"><i class="fa-solid fa-play"></i></a>{{/if}}
      {{#if @root.editable}}<a class="item-control" data-action="editItem" data-tooltip="GLOOM.Item.edit"><i class="fa-solid fa-pen"></i></a>
      <a class="item-control" data-action="deleteItem" data-tooltip="GLOOM.Item.delete"><i class="fa-solid fa-trash"></i></a>{{/if}}
    </li>
    {{else}}<li class="empty">{{localize "GLOOM.Company.none"}}</li>{{/each}}
  </ul>
  <h3>{{localize "GLOOM.Company.temporary"}}</h3>
  <ul class="item-list benefits">
    {{#each temporary as |b|}}
    <li class="item benefit{{#if b.used}} used{{/if}}" data-item-id="{{b.id}}">
      <div class="item-name"><strong>{{b.name}}</strong>{{#if b.reasonLabel}} <span class="tag">{{b.reasonLabel}}</span>{{/if}}{{#if b.used}} <span class="tag">{{localize "GLOOM.Company.usedTag"}}</span>{{/if}}
        <div class="desc">{{{b.description}}}</div></div>
      {{#unless b.used}}<a class="item-control" data-action="useBenefit" data-tooltip="GLOOM.Company.use"><i class="fa-solid fa-play"></i></a>{{/unless}}
      {{#if @root.editable}}<a class="item-control" data-action="toggleUsed" data-tooltip="GLOOM.Company.toggleUsed"><i class="fa-solid fa-check"></i></a>
      <a class="item-control" data-action="deleteItem" data-tooltip="GLOOM.Item.delete"><i class="fa-solid fa-trash"></i></a>{{/if}}
    </li>
    {{else}}<li class="empty">{{localize "GLOOM.Company.none"}}</li>{{/each}}
  </ul>
  <p class="hint">{{localize "GLOOM.Company.rulesHint"}}</p>
</section>
