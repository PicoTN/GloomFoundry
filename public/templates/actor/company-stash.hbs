<section class="tab stash-tab {{tabs.stash.cssClass}}" data-tab="stash" data-group="primary">
  <p class="hint">{{localize "GLOOM.Equip.stashRules"}}</p>
  {{#if takers.length}}
  <label class="taker">{{localize "GLOOM.Equip.takeAs"}}
    <select data-taker>{{selectOptions takerOptions selected=takerId}}</select></label>
  {{/if}}
  <ul class="item-list shop-items stash-items">
    {{#each stash as |i|}}
    <li class="item shop-item" data-item-id="{{i.id}}">
      <img src="{{i.img}}" alt="">
      <div class="item-name">{{i.name}} <span class="tag">{{i.slotLabel}}</span></div>
      <span class="stock-count">×{{i.quantity}}</span>
      {{#if @root.takers.length}}<button type="button" class="buy" data-action="takeItem"><i class="fa-solid fa-hand"></i> {{localize "GLOOM.Equip.takeButton"}}</button>{{/if}}
      {{#if @root.editable}}
      <a class="item-control" data-action="editItem" data-tooltip="GLOOM.Item.edit"><i class="fa-solid fa-pen"></i></a>
      <a class="item-control" data-action="deleteItem" data-tooltip="GLOOM.Item.delete"><i class="fa-solid fa-trash"></i></a>
      {{/if}}
    </li>
    {{else}}<li class="empty">{{localize "GLOOM.Equip.stashEmpty"}}</li>{{/each}}
  </ul>
</section>
