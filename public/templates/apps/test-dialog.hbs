<div class="gloomfoundry gloom-dialog">
  {{#if hasActor}}
  <div class="form-group">
    <label>{{localize "GLOOM.Test.attribute"}}</label>
    <select name="attribute">
      {{#each attributes}}<option value="{{key}}"{{#if selected}} selected{{/if}}>{{label}} ({{score}})</option>{{/each}}
    </select>
  </div>
  {{else}}
  <div class="form-group">
    <label>{{localize "GLOOM.Test.score"}}</label>
    <input type="number" name="score" value="{{score}}" step="1">
  </div>
  {{/if}}
  <div class="form-group">
    <label>{{localize "GLOOM.Test.tn"}}</label>
    <input type="number" name="tn" step="1" placeholder="{{localize 'GLOOM.Test.tnHidden'}}">
  </div>
  <div class="form-group">
    <label>{{localize "GLOOM.Test.bonus"}}</label>
    <input type="number" name="bonus" value="0" step="1">
    <p class="hint">{{localize "GLOOM.Test.bonusHint"}}</p>
  </div>
  {{#if backgrounds.length}}
  <div class="form-group">
    <label>{{localize "GLOOM.Test.background"}}</label>
    {{#if resist}}<p class="hint">{{localize "GLOOM.Test.resistBackgroundHint"}}</p>{{/if}}
    <select name="background">
      <option value="">—</option>
      {{#each backgrounds}}<option value="{{id}}">{{name}} (+1)</option>{{/each}}
    </select>
  </div>
  {{/if}}
  <div class="form-group">
    <label>{{localize "GLOOM.Mode.label"}}</label>
    <select name="mode">{{#each modes}}<option value="{{key}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}</select>
  </div>
</div>
