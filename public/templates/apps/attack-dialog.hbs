<div class="gloomfoundry gloom-dialog">
  {{#if targetName}}<p class="target"><i class="fa-solid fa-bullseye"></i> {{targetName}}</p>{{/if}}
  <div class="form-group">
    <label>{{localize "GLOOM.Attack.base"}}</label>
    <input type="number" name="base" value="{{base}}" min="0" step="1">
  </div>
  <div class="form-group">
    <label>{{localize "GLOOM.Attack.bonus"}}</label>
    <input type="number" name="bonus" value="0" step="1">
    <p class="hint">{{localize "GLOOM.Attack.bonusHint"}}</p>
  </div>
  {{#if lasting.length}}
  <fieldset class="lasting-bonuses">
    <legend>{{localize "GLOOM.Lasting.heading"}}</legend>
    {{#each lasting}}
    <label class="checkbox" data-tooltip="{{text}}"><input type="checkbox" name="lasting{{index}}" checked>
      <strong>{{label}}</strong> {{summary}}{{#if counted}} <i class="fa-solid fa-hourglass-half" data-tooltip="GLOOM.Lasting.spends"></i>{{/if}}</label>
    {{/each}}
    <p class="hint">{{localize "GLOOM.Lasting.dialogHint"}}</p>
  </fieldset>
  {{/if}}
  <div class="form-group">
    <label>{{localize "GLOOM.Attack.poisoned"}}</label>
    <input type="checkbox" name="poisoned"{{#if poisoned}} checked{{/if}}>
    <p class="hint">{{localize "GLOOM.Attack.poisonedHint"}}</p>
  </div>
  <div class="form-group">
    <label>{{localize "GLOOM.Attack.shield"}}</label>
    <input type="number" name="shield" value="{{#if shield}}{{shield}}{{else}}0{{/if}}" min="0" step="1">
  </div>
  <div class="form-group">
    <label>{{localize "GLOOM.Attack.ward"}}</label>
    <input type="checkbox" name="ward"{{#if warded}} checked{{/if}}>
    <p class="hint">{{localize "GLOOM.Attack.wardHint"}}</p>
  </div>
  <div class="form-group">
    <label>{{localize "GLOOM.Mode.label"}}</label>
    <select name="mode">{{#each modes}}<option value="{{key}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}</select>
  </div>
</div>
