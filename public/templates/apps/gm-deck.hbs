<section class="gloom-deck-panel">
  <div class="party-info">
    <span data-tooltip="GLOOM.Threat.mercenariesHint"><i class="fa-solid fa-users"></i> M = {{party.mercenaries}}</span>
    <span data-tooltip="GLOOM.Threat.clHint"><i class="fa-solid fa-signal"></i> CL {{party.cl}}</span>
    <span data-tooltip="GLOOM.Threat.challengeHint"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "GLOOM.Threat.trap"}} {{party.challenge.trap}} · {{localize "GLOOM.Threat.hazard"}} {{party.challenge.hazard}}</span>
  </div>
  <div class="threat{{#if threat.over}} over{{/if}}">
    <span><i class="fa-solid fa-skull"></i> {{localize "GLOOM.Threat.label"}} {{threat.total}} / {{threat.max}}</span>
    <select name="difficulty">{{#each threat.difficulties}}<option value="{{key}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}</select>
    <a data-action="refresh" data-tooltip="GLOOM.Threat.refresh"><i class="fa-solid fa-rotate"></i></a>
    <p class="hint">{{localize "GLOOM.Threat.sceneHint"}} ({{threat.count}}) · {{threat.fitsLabel}}</p>
  </div>
  {{#if deck}}
  {{> "gloom.deck-counts" deck}}
  <div class="deck-buttons">
    <button type="button" data-action="test"><i class="fa-solid fa-dice-d6"></i> {{localize "GLOOM.Test.title"}}</button>
    <button type="button" data-action="attack"><i class="fa-solid fa-swords"></i> {{localize "GLOOM.Attack.title"}}</button>
  </div>
  <div class="deck-buttons small">
    <button type="button" data-action="addBless">+ {{localize "GLOOM.Card.bless"}}</button>
    <button type="button" data-action="addCurse">+ {{localize "GLOOM.Card.curse"}}</button>
    <button type="button" data-action="clearTemporary">{{localize "GLOOM.Deck.clearTemporary"}}</button>
    <button type="button" data-action="reshuffle"><i class="fa-solid fa-shuffle"></i> {{localize "GLOOM.Deck.reshuffle"}}</button>
    <button type="button" data-action="rebuild"><i class="fa-solid fa-rotate"></i> {{localize "GLOOM.Deck.rebuild"}}</button>
  </div>
  {{#if deck.recent.length}}
  <h4>{{localize "GLOOM.Deck.recent"}}</h4>
  <div class="cards">{{#each deck.recent}}{{> "gloom.modifier-card" this}}{{/each}}</div>
  {{/if}}
  {{else}}
  <p class="notes">{{localize "GLOOM.Deck.notReady"}}</p>
  <button type="button" data-action="reshuffle">{{localize "GLOOM.Deck.create"}}</button>
  {{/if}}
</section>
