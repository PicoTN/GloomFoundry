<section class="sheet-body">
  <header class="sheet-header">
    <img class="profile" src="{{item.img}}" alt="" data-action="editImage" data-edit="img">
    <input class="name" type="text" name="name" value="{{item.name}}">
  </header>
  <label class="checkbox">
    <input type="checkbox" name="system.expended"{{#if system.expended}} checked{{/if}}>
    {{localize "GLOOM.Background.expended"}}
  </label>
  {{formInput systemFields.description value=system.description enriched=enrichedDescription toggled=true name="system.description"}}
</section>
