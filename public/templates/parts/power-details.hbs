<div class="power-details">
  {{#if primary}}<div class="action primary"><span class="tag">{{localize "GLOOM.Power.primary"}}</span>{{{primary}}}{{{primaryActs}}}</div>{{/if}}
  {{#if secondary}}<div class="action secondary"><span class="tag">{{localize "GLOOM.Power.secondary"}}</span>{{{secondary}}}{{{secondaryActs}}}</div>{{/if}}
  {{#if passive}}<div class="action passive">{{{passive}}}</div>{{/if}}
  {{#if effect}}<div class="action effect">{{{effect}}}{{{effectActs}}}</div>{{/if}}
  {{#if description}}<div class="action description">{{{description}}}{{{descriptionActs}}}</div>{{/if}}
</div>
